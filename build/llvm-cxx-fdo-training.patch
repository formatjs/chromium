diff --git a/toolchain/bootstrap/stage3/fdo_cxx.cpp b/toolchain/bootstrap/stage3/fdo_cxx.cpp
new file mode 100644
--- /dev/null
+++ b/toolchain/bootstrap/stage3/fdo_cxx.cpp
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: MIT
+// Exercise standard-library parsing and template instantiation during training.
+#include <algorithm>
+#include <array>
+#include <concepts>
+#include <functional>
+#include <map>
+#include <memory>
+#include <numeric>
+#include <optional>
+#include <ranges>
+#include <string>
+#include <tuple>
+#include <type_traits>
+#include <unordered_map>
+#include <utility>
+#include <variant>
+#include <vector>
+
+using Value = std::variant<int, double, std::string, std::vector<int>>;
+
+struct Record {
+  std::string name;
+  Value value;
+  std::optional<std::array<int, 4>> samples;
+  std::map<std::string, std::unique_ptr<Record>> children;
+};
+
+template <class T>
+concept Named = requires(const T& value) {
+  { value.name } -> std::convertible_to<std::string>;
+};
+
+template <class T>
+double summarize(const T& value) {
+  if constexpr (std::is_arithmetic_v<T>) {
+    return static_cast<double>(value);
+  } else if constexpr (std::ranges::range<T>) {
+    return std::accumulate(value.begin(), value.end(), 0.0);
+  }
+}
+
+template <Named T>
+std::tuple<std::string, double> describe(const T& record) {
+  double total = std::visit([](const auto& value) { return summarize(value); }, record.value);
+  if (record.samples) total += summarize(*record.samples);
+  for (const auto& [name, child] : record.children)
+    total += std::get<1>(describe(*child)) + name.size();
+  return {record.name, total};
+}
+
+template <std::size_t... I>
+auto coefficients(std::index_sequence<I...>) {
+  return std::tuple{std::array<double, I + 1>{}...};
+}
+
+int main() {
+  auto tables = coefficients(std::make_index_sequence<32>{});
+  std::vector<Record> records;
+  for (int index = 0; index < 64; ++index) {
+    Record record{std::to_string(index), index, std::array<int, 4>{index, 1, 2, 3}, {}};
+    if (index % 3 == 0) record.value = std::vector<int>{index, index + 1};
+    if (index % 5 == 0) record.value = std::string("template training");
+    if (index % 7 == 0) record.value = 0.5 * index;
+    records.push_back(std::move(record));
+  }
+  std::ranges::sort(records, {}, &Record::name);
+  std::unordered_map<std::string, std::pair<std::size_t, double>> groups;
+  std::function<double(const Record&)> score = [](const Record& record) {
+    return std::get<1>(describe(record));
+  };
+  for (const auto& record : records) {
+    auto& group = groups[record.name.substr(0, 1)];
+    ++group.first;
+    group.second += score(record);
+  }
+  double result = std::apply([](const auto&... values) {
+    return (0.0 + ... + static_cast<double>(values.size()));
+  }, tables);
+  for (const auto& [name, group] : groups) result += group.second / group.first + name.size();
+  return static_cast<int>(result) & 255;
+}
