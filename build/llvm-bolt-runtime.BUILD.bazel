load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

write_file(
    name = "runtime_config",
    out = "config.h",
    content = ["#define HAVE_ELF_H 1"],
)

cc_library(
    name = "bolt_rt_instr",
    srcs = ["instr.cpp"],
    hdrs = glob(["*.h"]) + [":config.h"],
    copts = [
        "-std=c++17",
        "-ffreestanding",
        "-fno-exceptions",
        "-fno-rtti",
        "-fno-stack-protector",
        "-fPIC",
        "-fomit-frame-pointer",
        "-mno-sse",
        "-mgeneral-regs-only",
    ],
    features = ["-thin_lto"],
    includes = ["."],
    linkstatic = True,
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
