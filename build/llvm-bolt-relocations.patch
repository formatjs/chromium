--- /dev/null
+++ b/bolt/runtime/BUILD.bazel
@@ -0,0 +1,34 @@
+load("@bazel_skylib//rules:write_file.bzl", "write_file")
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+
+package(default_visibility = ["//visibility:public"])
+
+write_file(
+    name = "runtime_config",
