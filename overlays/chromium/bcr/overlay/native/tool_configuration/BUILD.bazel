load(":execution.bzl", "native_linux_marker")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "share_native",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@llvm//constraints/libc:gnu.2.31",
    ],
    define_values = {"CHROMIUM_NATIVE_TOOLS": "1"},
)

toolchain_type(name = "native_linux_type")

native_linux_marker(name = "native_linux_marker")

toolchain(
    name = "native_linux_execution",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.31",
    ],
    toolchain = ":native_linux_marker",
    toolchain_type = ":native_linux_type",
)

config_setting(
    name = "blink_pch",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@llvm//constraints/libc:gnu.2.31",
    ],
    define_values = {
        "CHROMIUM_NATIVE_TOOLS": "1",
        "CHROMIUM_BLINK_PCH": "1",
    },
)
