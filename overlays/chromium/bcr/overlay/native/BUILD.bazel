# Dawn resolves angledata relative to its executable.
cc_test(
    name = "swiftshader_runtime_test",
    size = "medium",
    srcs = ["swiftshader_runtime_test.cc"],
    args = [
        "$(rlocationpath :libvk_swiftshader.so)",
        "$(rlocationpath :libVkLayer_khronos_validation.so)",
        "$(rlocationpath :vk_swiftshader_icd.json)",
    ],
    copts = [
        "-std=c++20",
        "-O2",
        "-fno-rtti",
        "-fno-exceptions",
    ],
    data = [
        ":angledata/VkLayer_khronos_validation.json",
        ":libVkLayer_khronos_validation.so",
        ":libvk_swiftshader.so",
        ":libvulkan.so.1",
        ":vk_swiftshader_icd.json",
    ],
    linkstatic = True,
    deps = [
        ":dawn_native_library",
        ":dawn_proc",
        "@jsoncpp",
        "@rules_cc//cc/runfiles",
    ],
)

