load("@chromium//native:blink_core_sources.bzl", "LIBRARIES")
load("//tools/ci:browser_targets.bzl", "linux_amd64_browser")
load(":probe.bzl", "blink_compile_probe")

package(default_visibility = ["//visibility:public"])

exports_files(["validate_pch.py"])

config_setting(
    name = "scan_disabled",
    define_values = {"CHROMIUM_COMPILE_PROBE_SCAN": "0"},
)

blink_compile_probe(
    name = "blink_layout_compile_probe",
    libraries = LIBRARIES,
)

linux_amd64_browser(
    name = "blink-layout-linux-amd64",
    srcs = [
        ":blink_layout_compile_probe",
        ":blink_layout_compile_probe_canvas",
    ],
)
