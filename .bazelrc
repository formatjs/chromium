startup --host_jvm_args=-Xmx8g
common --enable_bzlmod
# Keep live build inputs outside shared extracted-cache cleanup.
common --repo_contents_cache=
# Bound default concurrency for container builds.
build --jobs=8

# Release analysis state while compiling the full browser.
build:browser --jobs=4
build:browser --discard_analysis_cache
build:browser --notrack_incremental_state
build:browser --nokeep_state_after_build
# Selected Chromium libraries request scanning; toolchain bootstrap stays unchanged.
build:browser --cc_include_scanning

# Hosted workflows supply authentication through their Bazel wrapper.
build:buildbuddy --build_metadata=REPO_URL=https://github.com/formatjs/chromium.git
build:buildbuddy --build_metadata=VISIBILITY=PUBLIC
build:buildbuddy --bes_backend=grpcs://formatjs.buildbuddy.io
build:buildbuddy --bes_results_url=https://formatjs.buildbuddy.io/invocation/
build:buildbuddy --remote_cache=grpcs://formatjs.buildbuddy.io
build:buildbuddy --remote_executor=grpcs://formatjs.buildbuddy.io
build:buildbuddy --remote_download_outputs=toplevel
# Rebuild evicted intermediates in place.
build:buildbuddy --rewind_lost_inputs
build:buildbuddy --jobs=128
build:buildbuddy --ui_event_filters=-info
build:buildbuddy --extra_execution_platforms=//platforms:buildbuddy_linux_amd64

# Start Python tools with the pinned interpreter through the executor shell.
build --@rules_python//python/config_settings:bootstrap_impl=script
test --test_output=errors

# Keep Chromium and LLVM's C++ runtime in the same hardening mode.
build --cxxopt=-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE
build --host_cxxopt=-D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE
build --cxxopt=-D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS
build --host_cxxopt=-D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS
build --cxxopt=-D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS
build --host_cxxopt=-D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS

# Debian Bullseye desktop interfaces require symbols newer than glibc 2.28.
build --platforms=@llvm//platforms:linux_x86_64_gnu.2.31

# Keep BCR audio/video codec kernels optimized in the combined build.
build --per_file_copt=external/(opus|libvpx|aom|dav1d|flac|libwebm|crc32c)[+]/.*@-O2

# Chromium allocator uses nightly Rust features.
build --@rules_rust//rust/toolchain/channel=nightly
